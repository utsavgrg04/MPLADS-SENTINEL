# Frontend build-time configuration (Vite). Copy to frontend/.env.local for a
# local build, or set in Vercel: Project -> Settings -> Environment Variables.
#
# VITE_* variables are compiled INTO the public JavaScript bundle: anyone can
# read them. Never put a key, token or password in a VITE_ variable.
#
# Absolute base URL of the backend API, including the /api path, no trailing
# slash. Unset = '/api' (same origin), which the Vite dev server proxies to
# http://localhost:8000 -- the local development setup.
# VITE_API_BASE_URL=https://api.example.in/api
#
# Optional, server-only override for the Vite development proxy. Set this to
# the deployed API origin to use the live published dataset during local dev.
# Leave unset to use the local backend at http://localhost:8000.
# API_PROXY_TARGET=https://mplads-sentinel-api-pp90.onrender.com


